# Dependencies
node_modules

# Build output
dist
dist-ssr
*.tsbuildinfo
vite.config.d.ts
vite.config.js

# Vite cache
.vite

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea

# Claude Code per-project settings (local only) — BUT keep project-shared
# skills tracked so everyone gets the onboarding playbook etc.
.claude/*
!.claude/skills/
.claude/settings.local.json

# HRS internal source material (SACs, scope & sequences, internal docs)
# Used to anchor brain-break content generation. Contents ignored to keep
# IP off GitHub. Keep README.md, PROGRESS-LOG.md, .gitkeep, the in-scope
# HRS subject folders (Y7-10 scope as of 2026-07-08), and each subject's
# .gitkeep so the high-level structure is visible to anyone cloning the
# repo. Year-level subfolders and dropped files are local-only.
source-material/*
# Zipped copies of the same material (e.g. for moving between PCs).
source-material*.zip
!source-material/README.md
!source-material/PROGRESS-LOG.md
!source-material/.gitkeep
!source-material/english/
!source-material/maths/
!source-material/science/
!source-material/humanities/
!source-material/health-and-pe/
!source-material/_reference/
source-material/*/*
!source-material/*/.gitkeep
# _reference/: curriculum + school-wide reference docs (AC V9, VCE study
# designs, HRS scope & sequences). Track the README and the first-level
# folder skeleton only — the documents themselves stay local.
!source-material/_reference/README.md
!source-material/_reference/*/
source-material/_reference/*/*
!source-material/_reference/*/.gitkeep
